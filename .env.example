PORT=3000

# Redis KV Store for device API keys
REDIS_URL=redis://localhost:6379
# Alternatively:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Maximum number of device keys to keep in Redis (LRU eviction; default 50)
REDIS_LRU_CAP=50

# Frappe delivery-management API
FRAPPE_BASE_URL=https://akshayakalpa-pm-test.nvi.frappe.cloud
# FRAPPE_SITE_NAME=your-site-name   # Optional: only needed if the host serves multiple Frappe sites

# PostgreSQL — used only when DEBUG_MODE=true
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/akshayakalpa_debug

# Set to true to enable Postgres storage of device keys, trips, and coordinates.
# All DB writes are fire-and-forget and never block the HTTP response path.
# Leave false (or unset) in production.
DEBUG_MODE=false
