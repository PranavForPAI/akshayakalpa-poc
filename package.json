{
  "name": "akshayakalpa-poc-be",
  "version": "1.0.0",
  "description": "POC Backend for live GPS coordinate tracking and journeys",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
