{
  "name": "akshayakalpa-poc-be",
  "version": "1.0.0",
  "description": "Akshayakalpa Delivery Tracking Integration Backend (Frappe & Redis)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "db:migrate": "node scripts/assert-dev-db.mjs && prisma migrate dev",
    "db:migrate:create": "node scripts/assert-dev-db.mjs && prisma migrate dev --create-only",
    "db:check": "node scripts/migration-guard.mjs --all",
    "db:guard": "node scripts/migration-guard.mjs",
    "db:deploy": "node scripts/migration-guard.mjs && prisma migrate deploy",
    "db:status": "prisma migrate status",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/tripProcessing/worker/worker.ts",
    "reprocess-trip": "tsx src/cli/reprocess.ts reprocess-trip",
    "reprocess-range": "tsx src/cli/reprocess.ts reprocess-range",
    "osrm-region": "tsx src/cli/osrmRegion.ts",
    "match-trip": "tsx src/cli/matchTrip.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@prisma/client": "^6.4.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "commander": "^15.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "p-limit": "^7.3.3",
    "prisma": "6.4.1",
    "proj4": "^2.22.0",
    "rbush": "^4.0.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.10.2",
    "@types/proj4": "^2.5.6",
    "@types/rbush": "^4.0.0",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/winston": "^2.4.4",
    "@types/yamljs": "^0.2.34",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
